[Unit]
Description=Sanjipro SMS Blast Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/sanjipro-bot
ExecStart=/usr/bin/python3 /root/sanjipro-bot/bot.py
Restart=always
RestartSec=5
StandardOutput=append:/root/sanjipro-bot/bot.log
StandardError=append:/root/sanjipro-bot/bot.log
User=root
EnvironmentFile=/root/sanjipro-bot/.env
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
